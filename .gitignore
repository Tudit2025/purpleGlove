# Unity-generated caches, temporary files, and local editor settings.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Local Unity validation logs (reports and screenshots remain versioned).
/output/**/*.log

# Python-generated caches from local asset and validation tools.
__pycache__/
*.py[cod]

# Re-downloadable original music; edited game assets and provenance stay versioned.
/output/music-loop-v1/sources/*.mp3
/output/music-loop-v1/sources/*.part

# Build output.
/[Bb]uild/
/[Bb]uilds/

# IDE-generated project files and local settings.
/.vs/
/.idea/
/*.csproj
/*.sln
/*.slnx
/*.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.opendb
/*.VC.db

# Operating system metadata and Unity crash reports.
.DS_Store
Thumbs.db
/sysinfo.txt
