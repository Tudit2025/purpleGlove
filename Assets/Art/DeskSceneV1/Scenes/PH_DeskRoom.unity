--- !u!114 &1072772510
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1072772508}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84c97599336e4f83b956e7550a29ee31, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  spreads:
  - left: "\u9A6C\u6CF0\u5965\u7684\u65E7\u7B14\u8BB0\n\n\u4E94\u6708\u5341\u4E8C\u65E5\n\u7ED9\u7C73\u5170\u5185\u5EF7\u7F16\u4E86\n\u65B0\u7684\u6587\u4E66\u4F53\u7CFB\u3002\n\u6536\u4EF6\u4EBA\u4F1A\u8BFB\uFF0C\u4E0D\u7B49\u4E8E\n\u8BFB\u5230\u7684\u4E1C\u897F\u771F\u7684\u6765\u81EA\n\u7F72\u540D\u8005\u3002\u52A0\u5BC6\u4E0E\u7B7E\u540D\uFF0C\n\u4E0D\u80FD\u6DF7\u4E3A\u4E00\u8C08\u3002\n\n\u4E94\u6708\u5341\u4E5D\u65E5\n\u5DF4\u5C14\u6258\u6D1B\u9001\u6765\n\u4E03\u74E3\u82B1\u7248\u6837\u4E66\u3002"
    right: "\u4E94\u6708\u5341\u4E5D\u65E5 \xB7 \u7EED\n\u7B2C\u5341\u4E8C\u9875\u7B2C\u56DB\u884C\n\u91CD\u65B0\u6392\u8FC7\uFF0C\u65E7\u7248\n\u4E0D\u80FD\u518D\u4F5C\u67E5\u5B57\u4F9D\u636E\u3002\n\n\u516D\u6708\u4E8C\u65E5\n\u5B66\u751F\u95EE\uFF0C\u53D7\u80C1\u8FEB\u65F6\n\u7B7E\u4E0B\u7684\u540D\u5B57\u8FD8\u7B97\u4E0D\u7B97\n\u81EA\u5DF1\u7684\u3002\u6211\u6CA1\u6709\u7B54\u597D\u3002\n\u4EE5\u540E\u8BE5\u8865\u8FD9\u4E00\u8BFE\u3002\n\n\u540E\u9644\uFF1A\u516D\u79CD\u5BC6\u7801\u6559\u6848\n\u70B9\u51FB\u5DE6\u53F3\u9875\u7FFB\u9605"
  - left: "\u4E00 \xB7 \u51EF\u6492\u5BC6\u7801\n\n\u5B57\u6BCD\u5FAA\u73AF\u5E73\u79FB\u3002\n\u52A0\u5BC6\u52A0
      k\uFF0C\u89E3\u5BC6\u51CF k\u3002\n\u8D8A\u8FC7 Z \u540E\u56DE\u5230 A\u3002\n\n\u4F8B\uFF1Ak
      = 3\nABC  \u2192  DEF\nXYZ  \u2192  ABC\n\n\u4E09\u9053\u88C1\u53E3\uFF0C\u662F\u6211\n\u7EC3\u4E60\u7EB8\u7684\u4F4D\u79FB\u4E09\u8BB0\u53F7\u3002"
    right: "\u89E3\u5BC6\u4E0E\u6838\u9A8C\n\nDEF \u5411\u524D\u79FB\u4E09\u4F4D\uFF0C\n\u8FD8\u539F\u4E3A
      ABC\u3002\n\u7A7A\u683C\u4E0E\u6807\u70B9\u4FDD\u7559\u3002\n\n\u5E38\u89C1\u9519\u8BEF\uFF1A\n\u628A\u89E3\u5BC6\u65B9\u5411\u5199\u53CD\u3002\n\n\u8FD9\u79CD\u5BC6\u7801\u5BB9\u6613\u88AB\u8BD5\u51FA\u3002\n\u8BFB\u901A\u4E00\u6BB5\u8BDD\uFF0C\u4E0D\u80FD\n\u636E\u6B64\u786E\u8BA4\u7F72\u540D\u8005\u3002"
  - left: "\u4E8C \xB7 \u4E66\u672C\u5BC6\u7801\n\n\u5148\u7EA6\u5B9A\u4E66\u540D\u3001\u7248\u672C\u3001\n\u8BA1\u6570\u5355\u4F4D\u3002\n\n\u9875\u2014\u884C\u2014\u8BCD\u4E0E\n\u9875\u2014\u884C\u2014\u5B57\u6BCD\uFF0C\n\u662F\u4E24\u79CD\u4E0D\u540C\u89C4\u5219\u3002\n\n\u672C\u6848\u7528\u9875\u2014\u884C\u2014\u5B57\u6BCD\uFF0C\n\u5FFD\u7565\u7A7A\u683C\u4E0E\u6807\u70B9\uFF0C\n\u4ECE\u4E00\u5F00\u59CB\u8BA1\u6570\u3002"
    right: "\u4E2D\u6027\u7EC3\u4E60\n\n\u5047\u8BBE\u7EA6\u5B9A\u67D0\u9875\u67D0\u884C\uFF1A\nA
      SMALL LAMP\n\n\u8BA1\u6570\u65F6\u5199\u6210\uFF1A\nASMALLLAMP\n\u7B2C 1 \u4E2A\u5B57\u6BCD\u662F
      A\uFF0C\n\u7B2C 3 \u4E2A\u5B57\u6BCD\u662F M\u3002\n\n\u9519\u7248\u4E5F\u53EF\u80FD\u67E5\u51FA\u5B57\u6BCD\uFF0C\n\u5FC5\u987B\u5BF9\u7167\u7248\u6B21\u548C\u539F\u884C\uFF0C\n\u4E0D\u80FD\u9760\u987A\u773C\u4E0E\u5426\u5224\u65AD\u3002"
  - left: "\u4E09 \xB7 \u732A\u5708\u5BF9\u7167\n\u56FE\u5F62\u671D\u5411\u4E0E\u5706\u70B9\u56FA\u5B9A"
    right: "\u5BF9\u7167 \xB7 \u7EED\n\n\n\n\n\n\n\n\u56FE\u5F62\u66FF\u6362\u5B57\u6BCD\u3002\n\u5E26\u70B9\u4E0E\u4E0D\u5E26\u70B9\u4E0D\u540C\u3002\n\u5148\u8FA8\u5F00\u53E3\uFF0C\u518D\u8BA4\u5706\u70B9\uFF1B\n\u4E0D\u9760\u6A21\u7CCA\u58A8\u8FF9\u731C\u5B57\u3002"
  - left: "\u56DB \xB7 \u7EF4\u5409\u5C3C\u4E9A\n\n\u5B57\u6BCD\u7F16\u53F7 A=0 \u2026
      Z=25\u3002\n\u628A\u5173\u952E\u8BCD\u6362\u6210\u4F4D\u79FB\u91CF\uFF0C\n\u5FAA\u73AF\u91CD\u590D\u4F7F\u7528\u3002\n\n\u52A0\u5BC6\uFF1A\u660E\u6587\u52A0\u5173\u952E\u8BCD\uFF0C\n\u7ED3\u679C\u5BF9
      26 \u53D6\u4F59\u3002\n\u89E3\u5BC6\uFF1A\u5BC6\u6587\u51CF\u5173\u952E\u8BCD\uFF0C\n\u8D1F\u6570\u52A0
      26\u3002\n\n\u4F8B\uFF1AABC \u7528 KEY\n\u52A0\u5BC6\uFF0C\u5F97\u5230 KFA\u3002"
    right: "\u9010\u5B57\u6F14\u7B97\n\nA=0    K=10\n0+10=10  \u2192  K\n\nB=1   
      E=4\n1+4=5      \u2192  F\n\nC=2    Y=24\n2+24=26  \u2192  A\n\n\u77ED\u5BC6\u6587\u4E0D\u4FDD\u8BC1\u80FD\u53EA\u9760\n\u9891\u7387\u5206\u6790\u63A8\u51FA\u5173\u952E\u8BCD\u3002"
  - left: "\u4E94 \xB7 \u4EFF\u5C04\u5BC6\u7801\n\nA=0\uFF0CB=1 \u2026 Z=25\ny =
      (ax+b) mod 26\n\na \u5FC5\u987B\u4E0E 26 \u4E92\u8D28\uFF0C\n\u624D\u80FD\u552F\u4E00\u9006\u5411\u8FD8\u539F\u3002\n\n\u79C1\u4EBA\u7EC3\u4E60\u8BB0\u53F7\uFF1A\n\u9F7F\u6570\u4E3A
      a\uFF0C\u70B9\u6570\u4E3A b\u3002\n\n\u4F8B\uFF1Aa=5\uFF0Cb=8\nx = 21(y-8)
      mod 26"
    right: "\u6F14\u7B97\u4E0E\u9650\u5236\n\n\u660E\u6587 A \u7684\u7F16\u53F7\u662F
      0\u3002\n5\xD70+8 = 8\uFF0C\u5F97\u5230 I\u3002\n\n\u53CD\u7B97\uFF1A21\xD7(8-8)=0\uFF0C\n\u5F97\u5230
      A\u3002\n\n\u82E5\u8BA1\u7B97\u7ED3\u679C\u662F\u8D1F\u6570\uFF0C\n\u52A0 26
      \u76F4\u5230\u56DE\u5230\u8303\u56F4\u5185\u3002\n\n\u5B83\u4ECD\u4FDD\u7559\u5355\u8868\u66FF\u6362\u7684\n\u7EDF\u8BA1\u7279\u5F81\uFF0C\u5E76\u975E\u7EDD\u5BF9\u5B89\u5168\u3002"
  - left: "\u516D \xB7 \u6805\u680F\u5BC6\u7801\n\n\u6309\u7EA6\u5B9A\u884C\u6570\u6765\u56DE\u586B\u5B57\uFF0C\n\u518D\u9010\u884C\u8BFB\u51FA\u3002\n\n\u4E24\u884C\u4F8B\u9898\uFF1A\nHELLOWORLD\n\n\u4E0A\u884C\uFF1AH
      L O O L\n\u4E0B\u884C\uFF1AE L W R D\n\n\u6309\u884C\u8BFB\u51FA\uFF1A\nHLOOLELWRD"
    right: "\u8FD8\u539F\u6392\u5217\n\n\u5148\u786E\u5B9A\u6BCF\u884C\u7684\u5B57\u6570\uFF0C\n\u628A\u5BC6\u6587\u5206\u56DE\u5404\u884C\uFF0C\n\u518D\u6309\u4E0A\u4E0B\u5F80\u8FD4\u987A\u5E8F\u8BFB\u3002\n\n\u4E24\u884C\u3001\u5341\u4E2A\u5B57\u6BCD\u65F6\uFF0C\n\u6BCF\u884C\u5404\u6709\u4E94\u4E2A\u5B57\u6BCD\u3002\n\u5947\u6570\u957F\u5EA6\u65F6\uFF0C\u4E0A\u884C\n\u6BD4\u4E0B\u884C\u591A\u4E00\u4E2A\u3002\n\n\u89E3\u5BC6\u4E0D\u4F1A\u521B\u9020\u6216\u5220\u9664\n\u5B57\u6BCD\uFF0C\u53EA\u6062\u590D\u6392\u5217\u3002"
  leftPage: {fileID: 1099576195}
  rightPage: {fileID: 1103766841}
  leftNumber: {fileID: 1328191195}
  rightNumber: {fileID: 941740955}
