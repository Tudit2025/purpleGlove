  title: "\u7B2C\u4E00\u5E55 \xB7 \u9996\u6B21\u95E8\u8FB9\u4EA4\u8C08"
  context: "doc/ph-revised.md \u7B2C\u4E00\u5E55\u5E55\u672B\uFF1BFirstActFlow \u6309\u7559\u5B58\u3001\u6572\u95E8\u3001\u4EA4\u8C08\u3001\u684C\u524D\u603B\u7ED3\u7684\u987A\u5E8F\u89E6\u53D1\u3002"
  testOnly: 0
  initialVisitor: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
  arrivalSound: {fileID: 8300000, guid: a90926b1834a5135a7889bc8801033ca, type: 3}
  arrivalDelay: 0.54485416
  lines:
  - speaker: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
    text: "\u8001\u5E08\u7684\u4E8B\uFF0C\u7B49\u6838\u9A8C\u5B8C\u518D\u8C08\u3002\u8BF7\u628A\u2018\u5185\u5BB9\u8BFB\u5F97\u901A\u2019\u548C\u2018\u6587\u4EF6\u6CA1\u95EE\u9898\u2019\u90FD\u5199\u6E05\u695A\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u8FD9\u662F\u4E24\u4EF6\u4E8B\u3002"
  - speaker: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
    text: "\u5F53\u7136\u3002\u8BF7\u6309\u89C4\u7A0B\u529E\u3002"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u5DF2\u7ECF\u665A\u5341\u70B9\u4E86\u3002\u4E0B\u4E00\u4EFD\u5C01\u4EF6\u6B63\u5728\u767B\u8BB0\uFF0C\u8BF7\u5907\u597D\u65B0\u7684\u8721\u70DB\u3002"
