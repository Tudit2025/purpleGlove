  id: act1_secretary
  title: "\u7B2C\u4E00\u5E55 \xB7 \u9996\u6B21\u95E8\u8FB9\u4EA4\u8C08"
  context: "2026-11-02 \u8FD4\u56DE\u6539\u7A3F\uFF1B\u89C1 doc/performance-edit\u3002"
  testOnly: 0
  initialVisitor: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
  arrivalSound: {fileID: 0}
  closeShutterOnComplete: 1
  arrivalDelay: 0.1
  lines:
  - speaker: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
    text: "\u5362\u5361\u5927\u5E08\uFF0C\u5F85\u6838\u9A8C\u7684\u516C\u6587\u7A0D\u540E\u5373\u5230\u3002\u6B64\u4E8B\u5E72\u7CFB\u91CD\u5927\uFF0C\u8FD8\u8BF7\u60A8\u52A1\u5FC5\u786E\u4FDD\u6587\u4E66\u5185\u5BB9\u4E0E\u6765\u8DEF\u7686\u65E0\u7EB0\u6F0F\u3002"
    endEvent: 0
    choices:
    - id: ask_matteo
      text: "\u6211\u5E08\u7236\u9A6C\u6CF0\u5965\u4EBA\u5728\u54EA\u91CC\uFF1F"
      nextLine: 1
    - id: no_guarantee
      text: "\u6587\u4E66\u5C1A\u672A\u9001\u5230\uFF0C\u6211\u65E0\u6CD5\u4F5C\u4FDD\u3002"
      nextLine: 2
    - id: silence
      text: "\u2026\u2026"
      nextLine: 3
  - speaker: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
    text: "\u9A6C\u6CF0\u5965\u5927\u5E08\u76EE\u524D\u6B63\u5728\u534F\u52A9\u655D\u65B9\u5904\u7406\u673A\u5BC6\u8981\u52A1\u3002"
    endEvent: 1
    choices: []
  - speaker: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
    text: "\u81EA\u7136\uFF0C\u81EA\u7136\u3002\u4E00\u5207\u8BF7\u6309\u884C\u4F1A\u7684\u89C4\u77E9\u529E\u3002"
    endEvent: 1
    choices: []
  - speaker: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
    text: "\u60A8\u6CA1\u6709\u5F02\u8BAE\uFF0C\u90A3\u5C31\u518D\u597D\u4E0D\u8FC7\u4E86\u3002"
    endEvent: 1
    choices: []
