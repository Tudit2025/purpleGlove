  m_Script: {fileID: 11500000, guid: 430074f4a7b53dd4796d71325b7b59c6, type: 3}
  m_Name: act1_secretary
  m_EditorClassIdentifier: 
  id: act1_secretary
  title: "\u7B2C\u4E00\u5E55 \xB7 \u9996\u6B21\u95E8\u8FB9\u4EA4\u8C08"
  context: "2026-11-02 返回改稿；见 doc/performance-edit。"
  testOnly: 0
  initialVisitor: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
  arrivalSound: {fileID: 0}
  arrivalDelay: 0.1
  closeShutterOnComplete: 1
  lines:
  - speaker: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
    text: "卢卡大师，需要核验的文件马上就到了，事关重大，请您务必确保文件内容和来路都没有问题。"
    choices:
    - id: ask_matteo
      text: "解密大师马泰奥现在在哪里？"
      nextLine: 1
    - id: no_guarantee
      text: "我现在什么都没看到，不能给你保证。"
      nextLine: 2
    - id: silence
      text: "……"
      nextLine: 3
  - speaker: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
    text: "马泰奥大师现在在协助我们的保密工作。"
    endEvent: 1
  - speaker: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
    text: "当然，当然，请您按规矩来。"
    endEvent: 1
  - speaker: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
    text: "您没有意见自然是很好的。"
    endEvent: 1
