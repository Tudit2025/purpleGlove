  lines:
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u5E08\u7236\u53EE\u5631\u6211\u201C\u4FDD\u7559\u539F\u4EF6\u201D\uFF0C\u6307\u7684\u4F1A\u662F\u90A3\u4EFD\u8FD8\u6CA1\u9001\u5230\u7684\u519B\u4EE4\u5417\uFF1F"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u6B63\u4EF6\u672A\u81F3\uFF0C\u7C73\u5170\u7684\u4EBA\u5012\u5148\u6765\u50AC\u4FC3\u65BD\u538B\u4E86\u3002\u770B\u6765\u5E08\u7236\u679C\u771F\u843D\u5728\u4ED6\u4EEC\u624B\u91CC\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u201C\u4E03\u74E3\u82B1\u201D\u6307\u7684\u5E94\u5F53\u662F\u90A3\u518C\u65B0\u88C5\u8BA2\u7684\u300A\u7977\u6587\u96C6\u300B\u3002\u65E2\u662F\u7279\u5236\u7248\u6B21\uFF0C\u663E\u7136\u662F\u4F5C\u5BC6\u7801\u672C\u7528\u7684\u3002"
    endEvent: 0
    choices: []
