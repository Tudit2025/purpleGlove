  id: act2_archive_arrival
  title: "\u7B2C\u4E8C\u5E55 \xB7 \u7b2c\u4e94\u5341\u4e03\u53f7\u5C01\u6863\u9001\u8FBE"
  context: "2026-11-02 返回改稿；见 doc/performance-edit。"
  testOnly: 0
  initialVisitor: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
  arrivalSound: {fileID: 8300000, guid: a90926b1834a5135a7889bc8801033ca, type: 3}
  closeShutterOnComplete: 1
  arrivalDelay: 0.54485416
  lines:
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "五十七号封档到了，交存人是你师傅的熟人排字工巴尔托洛。"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "内含台账摘要和一张裁纸边角，我给你送进去。"
