  id: act2_archive_arrival
  title: "\u7B2C\u4E8C\u5E55 \xB7 \u7B2C\u4E03\u53F7\u5C01\u6863\u9001\u8FBE"
  context: "\u7B2C\u4E8C\u5E55\u5206\u6279\u6536\u4EF6\u3001\u4E66\u672C\u89E3\u8BFB\u4E0E\u6447\u94C3\u8C03\u6863\u3002"
  testOnly: 0
  initialVisitor: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
  arrivalSound: {fileID: 8300000, guid: a90926b1834a5135a7889bc8801033ca, type: 3}
  closeShutterOnComplete: 1
  arrivalDelay: 0.54485416
  lines:
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u7B2C\u4E03\u53F7\u5C01\u6863\u5230\u4E86\u3002\u6765\u6E90\u662F\u884C\u4F1A\u7EA0\u7EB7\u5E93\uFF0C\u4EA4\u5B58\u4EBA\u5DF4\u5C14\u6258\u6D1B\u3002"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u8FD9\u6B21\u9001\u6765\u53F0\u8D26\u6458\u8981\u548C\u4E00\u5F20\u88C1\u7EB8\u8FB9\u89D2\u3002\u539F\u59CB\u7B7E\u6536\u9875\u53E6\u5B58\uFF0C\u8C03\u9605\u6761\u4EF6\u5199\u5728\u6458\u8981\u4E0B\u65B9\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u8BF7\u628A\u8FD9\u4E24\u4EF6\u9001\u8FDB\u6765\u3002"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u5DF2\u7ECF\u767B\u8BB0\u3002\u6211\u5173\u597D\u89C2\u5BDF\u7A97\uFF0C\u518D\u8F6C\u5165\u4F20\u7269\u8231\u3002"
