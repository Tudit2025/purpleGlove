  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u8BF7\u5E2E\u6211\u8C03\u53D6\u7B2C\u4E94\u5341\u4E03\u53F7\u5C01\u6863\u63D0\u53CA\u7684\u539F\u59CB\u6863\u6848\u2014\u2014\u5BF9\u5E94\u7B2C17\u53F7\u59D4\u6258\uFF0C\u6279\u53F7\u4E03\u4E8C\u516D\u3002"
