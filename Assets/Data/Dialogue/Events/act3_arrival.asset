  m_Script: {fileID: 11500000, guid: 430074f4a7b53dd4796d71325b7b59c6, type: 3}
  m_Name: act3_arrival
  m_EditorClassIdentifier: 
  id: act3_arrival
  title: "\u7B2C\u4E09\u5E55 \xB7 \u6B63\u5F0F\u6838\u9A8C\u4EF6\u5230\u8FBE"
  context: "2026-11-02 返回改稿；见 doc/performance-edit。"
  testOnly: 0
  initialVisitor: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
  arrivalSound: {fileID: 8300000, guid: a90926b1834a5135a7889bc8801033ca, type: 3}
  closeShutterOnComplete: 1
  arrivalDelay: 0.54485416
  lines:
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "卢卡，这次核验委托的内容，军情译录件送到了。确实是我们行会印刷的。"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "封包里有四个文件：行会承办这次译录时的译录委托，上面有你师傅的亲笔签名；还有他译录的军情密文；一张核验表。"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "最后还有带法方签名的法文原文，这张好像也是我们行会印刷的。"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "好的，请送进来吧。"
