  id: act3_arrival
  title: "\u7B2C\u4E09\u5E55 \xB7 \u6B63\u5F0F\u6838\u9A8C\u4EF6\u5230\u8FBE"
  context: "\u7B2C\u4E09\u5E55\u8F6C\u573A\u5B8C\u6210\u540E\u4ECB\u7ECD\u6B63\u5F0F\u6838\u9A8C\u4EF6\uFF0C\u89C2\u5BDF\u7A97\u5B8C\u5168\u5173\u95ED\u540E\u5F00\u59CB\u6536\u4EF6\u3002"
  testOnly: 0
  initialVisitor: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
  arrivalSound: {fileID: 8300000, guid: a90926b1834a5135a7889bc8801033ca, type: 3}
  closeShutterOnComplete: 1
  arrivalDelay: 0.54485416
  lines:
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u5348\u591C\u4E86\u3002\u7C73\u5170\u5185\u5EF7\u7B2C\u5341\u4E03\u53F7\u59D4\u6258\uFF0C\u4E89\u8BAE\u7684\u519B\u60C5\u8BD1\u5F55\u4EF6\u9001\u5230\u4E86\u3002\u884C\u4F1A\u5DF2\u767B\u8BB0\uFF0C\u88C5\u8BA2\u6279\u53F7\u4E03\u2014\u3007\u4E09\u4E00\u3002"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u5C01\u5305\u91CC\u6709\u56DB\u5F20\u7EB8\uFF1A\u7C73\u5170\u59D4\u6258\u3001\u884C\u4F1A\u767B\u8BB0\u627F\u529E\u7684\u8BD1\u5F55\u59D4\u6258\uFF0C\u4E0A\u9762\u6709\u9A6C\u6CF0\u5965\u5148\u751F\u7684\u4EB2\u7B14\u7B7E\u540D\uFF1B\u4ED6\u8BD1\u5F55\u7684\u519B\u60C5\u5BC6\u6587\uFF1B\u4E00\u5F20\u6838\u9A8C\u8868\uFF1B\u8FD8\u6709\u5E26\u6CD5\u65B9\u7B7E\u540D\u7684\u6CD5\u6587\u539F\u6587\u3002"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u6838\u9A8C\u8868\u6709\u4E24\u4E2A\u7B7E\u540D\u680F\uFF0C\u5206\u522B\u786E\u8BA4\u660E\u6587\u8FD8\u539F\u548C\u6587\u4EF6\u6765\u6E90\u3002\u8BF7\u5206\u5F00\u586B\u5199\uFF0C\u6CA1\u67E5\u6E05\u7684\u53EF\u4EE5\u4E0D\u7B7E\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u628A\u6765\u4EF6\u9001\u8FDB\u6765\u3002\u6211\u8FD8\u8981\u62FF\u8FD9\u4E2A\u6848\u53F7\u6838\u5BF9\u7B2C\u4E03\u53F7\u5C01\u6863\u7684\u8BB0\u5F55\u3002"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u597D\u3002\u6211\u5408\u4E0A\u89C2\u5BDF\u7A97\uFF0C\u518D\u4ECE\u4F20\u7269\u8231\u9001\u8FDB\u53BB\u3002"
