  lines:
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u5361\u62C9\u6CD5\u5DF2\u5728\u524D\u5385\u767B\u8BB0\uFF0C\u7B49\u5019\u4EE3\u9886\u539F\u4EF6\u3002"
  - speaker: {fileID: 11400000, guid: 94175edd6df4cee43a29a74d19194265, type: 2}
    text: "\u5370\u574A\u5929\u5929\u6539\u7248\u3002\u5E74\u8F7B\u4EBA\uFF0C\u522B\u628A\u6392\u5B57\u7684\u65E7\u8D26\u5199\u6210\u5916\u4EA4\u4E8B\u4EF6\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u662F\u4E0D\u662F\u6392\u5B57\u7684\u65E7\u8D26\uFF0C\u8981\u7B49\u539F\u59CB\u8BB0\u5F55\u9001\u5230\u518D\u6838\u5BF9\u3002\u73B0\u5728\u8FD9\u4E9B\u7EB8\u8FD8\u4E0D\u80FD\u4EA4\u8D70\u3002"
