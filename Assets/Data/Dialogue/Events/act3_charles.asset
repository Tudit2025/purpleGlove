  id: act3_charles
  title: "\u7B2C\u4E09\u5E55 \xB7 \u590F\u5C14\u95E8\u8FB9\u4EA4\u8C08"
  context: "2026-11-02 \u8FD4\u56DE\u6539\u7A3F\uFF1B\u89C1 doc/performance-edit\u3002"
  testOnly: 0
  initialVisitor: {fileID: 11400000, guid: 5d5f70330e981614aa3705d5825e6737, type: 2}
  arrivalSound: {fileID: 8300000, guid: a90926b1834a5135a7889bc8801033ca, type: 3}
  closeShutterOnComplete: 1
  arrivalDelay: 0.54485416
  lines:
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u5362\u5361\uFF0C\u6CD5\u56FD\u4EE3\u8868\u590F\u5C14\u5148\u751F\u6C42\u89C1\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: 5d5f70330e981614aa3705d5825e6737, type: 2}
    text: "\u65E5\u5B89\uFF0C\u5927\u5E08\u3002\u5018\u82E5\u90A3\u4EFD\u5BC6\u6587\u58F0\u79F0\u6CD5\u56FD\u5C06\u4E8E\u516D\u6708\u5341\u516B\u65E5\u8D8A\u5883\uFF0C\u8BF7\u60A8\u5207\u52FF\u66FF\u5B83\u7684\u6765\u6E90\u4F5C\u4FDD\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: 5d5f70330e981614aa3705d5825e6737, type: 2}
    text: "\u53EA\u8981\u60A8\u80FD\u627E\u51FA\u786E\u51FF\u7684\u7269\u8BC1\uFF0C\u6CD5\u65B9\u5B9A\u4F1A\u5168\u529B\u62A4\u4F4F\u4EE4\u5E08\u7684\u5468\u5168\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u539F\u7A3F\u4E0A\u4E0D\u662F\u6709\u60A8\u7684\u4EB2\u7B14\u7B7E\u540D\u5417\uFF1F\u5018\u82E5\u519B\u4EE4\u662F\u4F2A\u9020\u7684\uFF0C\u60A8\u4E3A\u4F55\u4E0D\u5F53\u4F17\u63ED\u7A7F\uFF1F"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: 5d5f70330e981614aa3705d5825e6737, type: 2}
    text: "\u90A3\u786E\u662F\u6211\u7684\u7B14\u8FF9\u3002\u4F46\u6211\u4E0D\u4FBF\u5411\u5916\u754C\u900F\u9732\u81EA\u5DF1\u66FE\u79C1\u4E0B\u4E0E\u7C73\u5170\u4EBA\u7B7E\u7F72\u8FC7\u201C\u53E6\u4E00\u4EFD\u201D\u6587\u4EF6\uFF0C\u56E0\u6B64\u4E0D\u80FD\u76F4\u63A5\u51FA\u9762\u5426\u8BA4\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: 5d5f70330e981614aa3705d5825e6737, type: 2}
    text: "\u65B9\u624D\u7684\u627F\u8BFA\uFF0C\u6211\u4F1A\u7ACB\u4E0B\u5B57\u636E\u5E76\u4EB2\u7B14\u7F72\u540D\u3002\u4ECA\u591C\u6240\u8A00\uFF0C\u8FD8\u671B\u5927\u5E08\u4E09\u601D\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u8865\u5145\u51ED\u6761\u5DF2\u767B\u8BB0\uFF0C\u5E76\u5165\u7B2C17\u53F7\u59D4\u6258\u3001\u6279\u53F7\u4E03\u4E8C\u516D\u5377\u5B97\u3002\u89C2\u5BDF\u7A97\u5408\u4E0A\u540E\uFF0C\u6211\u4ECE\u4F20\u7269\u8231\u9012\u8FDB\u6765\u3002"
    endEvent: 0
    choices: []
