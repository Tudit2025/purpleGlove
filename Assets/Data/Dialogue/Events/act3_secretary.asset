  lines:
  - speaker: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
    text: "\u660E\u6587\u65E2\u7136\u5B8C\u6574\uFF0C\u539F\u6765\u7684\u5DE5\u4F5C\u7EB8\u5C31\u4EA4\u56DE\u6765\u5427\u3002\u53EA\u7559\u4E00\u4EFD\u6E05\u6D01\u7684\u8BD1\u6587\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u539F\u4EF6\u987B\u4FDD\u7559\u5230\u6765\u6E90\u6838\u9A8C\u7ED3\u675F\u3002\u660E\u6587\u8FD8\u539F\u7684\u7B7E\u540D\uFF0C\u4E0D\u662F\u6765\u6E90\u786E\u8BA4\u3002"
  - speaker: {fileID: 11400000, guid: 4f4aaab452df020409975b2690d7b648, type: 2}
    text: "\u5F02\u8BAE\u6211\u4F1A\u8BB0\u4E0B\u3002\u516C\u7235\u4ECD\u5728\u7B49\u4F60\u7684\u6838\u9A8C\u7ED3\u679C\u3002"
