  id: act3_summary
  title: "\u7B2C\u4E09\u5E55 \xB7 \u5362\u5361\u5E55\u672B\u72EC\u767D"
  context: "2026-11-02 \u8FD4\u56DE\u6539\u7A3F\uFF1B\u89C1 doc/performance-edit\u3002"
  testOnly: 0
  initialVisitor: {fileID: 0}
