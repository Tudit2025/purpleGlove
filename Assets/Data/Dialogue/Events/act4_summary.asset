  id: act4_summary
  title: "\u7B2C\u56DB\u5E55 \xB7 \u4E24\u4EFD\u660E\u6587\u540E\u7684\u72EC\u767D"
  context: "doc/ph-revised.md \u7B2C\u56DB\u5E55\u72EC\u767D\u540E\u76F4\u63A5\u8F6C\u5165\u7B2C\u4E94\u5E55\uFF0C\u4E09\u4EFD\u4E3B\u52A8\u6587\u4EF6\u3001\u6447\u94C3\u4EA4\u5377\u3002"
  testOnly: 0
  initialVisitor: {fileID: 0}
  arrivalSound: {fileID: 0}
  closeShutterOnComplete: 1
  arrivalDelay: 0.1
  lines:
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u5723\u9A6C\u4E01\uFF0C\u5317\u95E8\u3002\u5E08\u7236\u7684\u4FE1\u8BF4\uFF0C\u516D\u70B9\u5C31\u4F1A\u4ECE\u90A3\u91CC\u8F6C\u62BC\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u4ED6\u627F\u8BA4\u81EA\u5DF1\u77E5\u9053\u90A3\u4EFD\u547D\u4EE4\u6709\u5047\uFF0C\u8FD8\u662F\u7B7E\u4E86\u540D\u3002\u4E3A\u4E86\u8BA9\u5DF4\u5C14\u6258\u6D1B\u4E00\u5BB6\u51FA\u53BB\uFF0C\u4ED6\u628A\u81EA\u5DF1\u7684\u540D\u5B57\u7559\u5728\u4E86\u4E0A\u9762\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u6362\u7248\u8BB0\u5F55\u4E5F\u5728\u8FD9\u91CC\u3002\u6CD5\u65B9\u6CA1\u6709\u6838\u7B7E\u7684\u65B0\u6B63\u6587\uFF0C\u6CBF\u7528\u4E86\u65E7\u5C01\u9762\u4E0A\u7684\u7B7E\u540D\uFF1B\u5361\u62C9\u6CD5\u7ECF\u624B\u4E86\u4E24\u6B21\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u6211\u60F3\u628A\u5E08\u7236\u5E26\u56DE\u6765\u3002\u53EF\u73B0\u5728\uFF0C\u6211\u4E0D\u80FD\u518D\u628A\u6551\u4ED6\u548C\u8BC1\u660E\u4ED6\u6CA1\u6709\u505A\u8FC7\u5F53\u6210\u540C\u4E00\u4EF6\u4E8B\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u5B57\u53E5\u5DF2\u7ECF\u8FD8\u539F\uFF0C\u8BB0\u5F55\u4E5F\u5BF9\u4E0A\u4E86\u3002\u63A5\u4E0B\u6765\uFF0C\u8981\u7531\u6211\u51B3\u5B9A\u600E\u6837\u7B7E\u3001\u600E\u6837\u4EA4\u3002"
