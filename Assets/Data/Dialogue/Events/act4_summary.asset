  id: act4_summary
  title: "\u7B2C\u56DB\u5E55 \xB7 \u4E24\u4EFD\u660E\u6587\u540E\u7684\u72EC\u767D"
  context: "2026-11-02 \u8FD4\u56DE\u6539\u7A3F\uFF1B\u89C1 doc/performance-edit\u3002"
  testOnly: 0
  initialVisitor: {fileID: 0}
  arrivalSound: {fileID: 0}
  closeShutterOnComplete: 1
  arrivalDelay: 0.1
  lines:
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u201C\u5723\u9A6C\u4E01\uFF0C\u5317\u95E8\u201D\u2026\u2026\u770B\u6765\u5E08\u7236\u5C31\u88AB\u6263\u62BC\u5728\u5723\u9A6C\u4E01\u4FEE\u9053\u9662\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u4ED6\u5728\u4FE1\u91CC\u627F\u8BA4\uFF0C\u81EA\u5DF1\u660E\u77E5\u519B\u4EE4\u662F\u5047\uFF0C\u5374\u8FD8\u662F\u4E3A\u4E86\u6551\u4EBA\u7B7E\u4E0B\u4E86\u540D\u5B57\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u4F2A\u9020\u7684\u519B\u4EE4\u79FB\u82B1\u63A5\u6728\uFF0C\u76D7\u7528\u4E86\u590F\u5C14\u5728\u5546\u961F\u901A\u884C\u534F\u8BAE\u4E0A\u7684\u771F\u8FF9\u3002\u602A\u4E0D\u5F97\u6CD5\u56FD\u4EBA\u6295\u9F20\u5FCC\u5668\uFF0C\u4E0D\u6562\u516C\u5F00\u58F0\u5F20\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u5E08\u7236\u7684\u81EA\u8FF0\u4E0E\u5370\u574A\u6362\u7248\u7684\u539F\u4EF6\uFF0C\u90FD\u662F\u94C1\u8BC1\u3002\u63A5\u4E0B\u6765\u8BE5\u5982\u4F55\u843D\u7B14\uFF0C\u5168\u770B\u6211\u7684\u51B3\u65AD\u4E86\u3002"
    endEvent: 0
    choices: []
