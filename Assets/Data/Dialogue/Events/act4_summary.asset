  m_Script: {fileID: 11500000, guid: 430074f4a7b53dd4796d71325b7b59c6, type: 3}
  m_Name: act4_summary
  m_EditorClassIdentifier: 
  id: act4_summary
  title: "\u7B2C\u56DB\u5E55 \xB7 \u4E24\u4EFD\u660E\u6587\u540E\u7684\u72EC\u767D"
  context: "2026-11-02 返回改稿；见 doc/performance-edit。"
  testOnly: 0
  initialVisitor: {fileID: 0}
  arrivalSound: {fileID: 0}
  closeShutterOnComplete: 1
  arrivalDelay: 0.1
  lines:
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "圣马丁，北门。这个应该就是他们关押他的地方。"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "他承认自己知道文件是假的，还是签了名字。"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "伪造的军令用了法国人在商路协议上的签名，这应该就是法国人不想让人看见的东西。"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "老师的自白和换档的原件是重要证据，看来也到了我做选择的时候了。"
