  lines:
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u5362\u5361\uFF0C\u6211\u6765\u63A5\u4EF6\u3002{\u6765\u6E90}"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u6362\u7248\u539F\u4EF6\u6309\u7533\u8BF7\u529E\u7406\uFF1A{\u539F\u4EF6}\u3002{\u81EA\u8FF0}"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "{\u624B\u7EED}"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u4EA4\u4EF6\u4E0D\u7B49\u4E8E\u6240\u6709\u627F\u8BFA\u5DF2\u7ECF\u529E\u6210\u3002\u540E\u7EED\u51ED\u636E\u4F1A\u5982\u5B9E\u9001\u56DE\u3002\u73B0\u5728\u5408\u4E0A\u89C2\u5BDF\u7A97\uFF0C\u4ECE\u8F6C\u95E8\u63A5\u8D70\u6587\u4EF6\u3002"
