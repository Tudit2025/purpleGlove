  id: act6_endorsed_report
  title: "\u7B2C\u516D\u5E55 \xB7 \u516D\u70B9\u7684\u8F6C\u62BC\u767B\u8BB0"
  context: "doc/ph-revised.md \u7B2C\u516D\u5E55\uFF1A\u6240\u6709\u53F0\u8BCD\u901A\u8FC7\u63A2\u89C6\u53E3\uFF0C\u5728\u4E3B\u95E8\u5F00\u542F\u524D\u5B8C\u6210\u3002"
  testOnly: 0
  initialVisitor: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
  arrivalSound: {fileID: 8300000, guid: a90926b1834a5135a7889bc8801033ca, type: 3}
  closeShutterOnComplete: 1
  arrivalDelay: 0.54485416
  lines:
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u516D\u70B9\u7684\u8F6C\u62BC\u767B\u8BB0\u9001\u56DE\u6765\u4E86\u3002\u5362\u5361\uFF0C\u9A6C\u6CF0\u5965\u5DF2\u6309\u539F\u5B89\u6392\u88AB\u8F6C\u79FB\u3002"
    choices: []
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u4F60\u4EEC\u6CA1\u6709\u628A\u4ED6\u7559\u4E0B\uFF1F"
    choices: []
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u4F60\u4E3A\u519B\u4EE4\u6765\u6E90\u4F5C\u4E86\u62C5\u4FDD\u3002\u672C\u6B21\u4EA4\u5377\u6CA1\u6709\u542F\u52A8\u5171\u540C\u4E89\u8BAE\u5BA1\u67E5\uFF0C\u4E5F\u6CA1\u6709\u529E\u6210\u6682\u505C\u8F6C\u62BC\u7684\u624B\u7EED\u3002"
    choices: []
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u4ED6\u88AB\u9001\u5230\u54EA\u91CC\uFF1F"
    choices: []
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u8FD9\u4EFD\u767B\u8BB0\u53EA\u8BB0\u4E86\u8F6C\u51FA\uFF0C\u540E\u7EED\u53BB\u5411\u8FD8\u5728\u8FFD\u67E5\u3002\u6362\u7248\u8BC1\u636E\u4ECD\u5728\uFF0C\u4E8B\u60C5\u6CA1\u6709\u5230\u6B64\u7ED3\u675F\u3002"
    choices: []
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u539F\u4EF6\u4EA4\u63A5\u4E5F\u5DF2\u767B\u8BB0\uFF1A{\u539F\u4EF6}\u3002\u6211\u5408\u4E0A\u63A2\u89C6\u53E3\uFF0C\u628A\u56DE\u6267\u9001\u8FDB\u53BB\u3002"
    choices: []
