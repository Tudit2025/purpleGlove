  title: "\u7B2C\u516D\u5E55 \xB7 \u7F3A\u9875"
  context: "doc/ph-revised.md \u7B2C\u516D\u5E55\uFF1A\u6240\u6709\u53F0\u8BCD\u901A\u8FC7\u63A2\u89C6\u53E3\uFF0C\u5728\u4E3B\u95E8\u5F00\u542F\u524D\u5B8C\u6210\u3002"
  testOnly: 0
  initialVisitor: {fileID: 11400000, guid: 7a00ade9d6e452c4ba72f85697a011c7, type: 2}
  arrivalSound: {fileID: 8300000, guid: a90926b1834a5135a7889bc8801033ca, type: 3}
  closeShutterOnComplete: 1
  arrivalDelay: 0.54485416
  lines:
  - speaker: {fileID: 11400000, guid: 7a00ade9d6e452c4ba72f85697a011c7, type: 2}
    text: "\u5362\u5361\u3002\u5C01\u5957\u91CC\u90A3\u6BB5\u81EA\u8FF0\uFF0C\u4E5F\u4EA4\u4E0A\u53BB\u4E86\u5417\uFF1F"
    choices: []
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u6211\u70E7\u4E86\u8BD1\u51FA\u6765\u7684\u90A3\u5F20\u7EB8\u3002"
    choices: []
  - speaker: {fileID: 11400000, guid: 7a00ade9d6e452c4ba72f85697a011c7, type: 2}
    text: "\u4E3A\u4EC0\u4E48\uFF1F"
    choices: []
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u6211\u6015\u4ED6\u4EEC\u62FF\u7740\u4F60\u7684\u627F\u8BA4\uFF0C\u5C31\u4E0D\u80AF\u8BA9\u4F60\u56DE\u6765\u3002"
    choices: []
  - speaker: {fileID: 11400000, guid: 7a00ade9d6e452c4ba72f85697a011c7, type: 2}
    text: "\u4FE1\u8FD8\u5728\uFF0C\u7B7E\u8FC7\u7684\u540D\u5B57\u4E5F\u8FD8\u5728\u3002\u4F60\u4E0D\u80FD\u66FF\u6211\u8BF4\uFF0C\u4E8B\u60C5\u5DF2\u7ECF\u8BB2\u6E05\u695A\u4E86\u3002"
    choices: []
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u6211\u53EA\u662F\u60F3\u5148\u4FDD\u4F4F\u4F60\u3002"
    choices: []
  - speaker: {fileID: 11400000, guid: 7a00ade9d6e452c4ba72f85697a011c7, type: 2}
    text: "\u6211\u56DE\u6765\u4E86\u3002\u5269\u4E0B\u7684\u4E8B\uFF0C\u8BA9\u6211\u81EA\u5DF1\u56DE\u7B54\u3002"
    choices: []
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u89C1\u8BC1\u624B\u7EED\u529E\u59A5\uFF0C\u5C01\u95E8\u7684\u671F\u9650\u4E5F\u5230\u4E86\u3002\u6211\u5148\u5408\u4E0A\u63A2\u89C6\u53E3\uFF0C\u518D\u89E3\u9664\u95E8\u5C01\u3002"
    choices: []
