  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u4ED6\u5728\u5916\u9762\uFF1F"
    choices: []
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u5C31\u5728\u6211\u8EAB\u540E\u3002\u5148\u628A\u8FD9\u4EFD\u5177\u540D\u51ED\u636E\u4EA4\u7ED9\u4F60\uFF0C\u6211\u5173\u4E0A\u63A2\u89C6\u53E3\uFF0C\u9001\u4EF6\u540E\u8BF7\u4ED6\u8FC7\u6765\u3002"
