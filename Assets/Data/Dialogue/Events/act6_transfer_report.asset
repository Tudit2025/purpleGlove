    choices: []
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u5A01\u5C3C\u65AF\u4E0E\u6CD5\u56FD\u4EE3\u8868\u89C1\u5230\u60A8\u7684\u6838\u9A8C\u62A5\u544A\u540E\uFF0C\u5F53\u573A\u8981\u6C42\u6682\u505C\u7CAE\u7AD9\u8868\u51B3\u3002\u5361\u62C9\u6CD5\u5DF2\u88AB\u8D23\u4EE4\u7559\u5019\u5F7B\u67E5\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u5370\u574A\u6362\u7248\u7684\u5185\u60C5\u5DF2\u7ECF\u4F20\u5F00\uFF0C\u90A3\u4EFD\u6362\u7248\u539F\u4EF6\u4E5F\u5DF2\u6309\u60A8\u7684\u7533\u8BF7\u8F6C\u4EA4\u51FA\u53BB\u4E86\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u8FD9\u91CC\u6709\u51E0\u4EFD\u6668\u4F1A\u7684\u5904\u7406\u56DE\u6267\uFF0C\u6211\u7ED9\u60A8\u9012\u8FDB\u6765\u3002"
    endEvent: 0
    choices: []
