  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u884C\u4F1A\u4F1A\u59A5\u5584\u7559\u5B58\u8FD9\u4E9B\u4EA4\u63A5\u56DE\u6267\u3002\u4E00\u65E6\u6709\u65B0\u7684\u6D88\u606F\uFF0C\u6211\u4F1A\u518D\u6765\u901A\u77E5\u60A8\u3002"
