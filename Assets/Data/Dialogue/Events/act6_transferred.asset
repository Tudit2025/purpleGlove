  lines:
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u51ED\u636E\u5DF2\u7ECF\u9001\u5230\u3002{\u53BB\u5411\u540E\u679C}"
    choices: []
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u8FD9\u6B21\u8F6C\u62BC\u505C\u4E86\u3002\u4EE5\u540E\u7684\u4E8B\u5462\uFF1F"
    choices: []
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u9A6C\u6CF0\u5965\u8FD8\u8981\u7559\u5019\u6838\u9A8C\u3002\u4EE5\u540E\u6BCF\u4E00\u6B21\u5BF9\u7167\u539F\u4EF6\uFF0C\u90FD\u8981\u5411\u6301\u6709\u8005\u63D0\u51FA\u7533\u8BF7\u3002"
    choices: []
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u6211\u628A\u8BC1\u636E\u9001\u51FA\u53BB\u4E86\uFF0C\u4E5F\u628A\u5F80\u540E\u67E5\u8BC1\u7684\u8DEF\u4EA4\u5230\u4E86\u522B\u4EBA\u624B\u91CC\u3002"
    choices: []
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u884C\u4F1A\u4F1A\u7559\u597D\u8FD9\u4E9B\u56DE\u6267\u3002\u8FD8\u6709\u65B0\u7684\u6D88\u606F\uFF0C\u6211\u4ECD\u4ECE\u8FD9\u91CC\u544A\u8BC9\u4F60\u3002"
    choices: []
