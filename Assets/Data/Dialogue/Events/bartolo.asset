  lines:
  - speaker: {fileID: 11400000, guid: 4048a685d27644d4289d116428639a0b, type: 2}
    text: "\u7EB8\u8FB9\u53EF\u4EE5\u88C1\u6389\uFF0C\u6362\u8FC7\u7684\u7248\u5374\u4F1A\u7559\u4E0B\u75D5\u8FF9\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u5148\u544A\u8BC9\u6211\uFF0C\u539F\u59CB\u7B7E\u6536\u9875\u5B58\u5728\u54EA\u91CC\u3002"
  - speaker: {fileID: 11400000, guid: 4048a685d27644d4289d116428639a0b, type: 2}
    text: "\u884C\u4F1A\u7684\u7EA0\u7EB7\u5C01\u5B58\u5E93\uFF0C\u767B\u8BB0\u53F7\u548C\u53F0\u8D26\u80FD\u5BF9\u5F97\u4E0A\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
