  id: beatrice
  title: "02 \xB7 \u7B2C\u4E03\u53F7\u5C01\u6863"
  context: "\u7B2C\u4E8C\u5E55\uFF1A\u8D1D\u963F\u7279\u4E3D\u5207\u7ED9\u51FA\u53EF\u6838\u9A8C\u7684\u6863\u6848\u65B9\u5411\u3002"
  testOnly: 0
  initialVisitor: {fileID: 11400000, guid: 3fa28df6608b7f44db2e8d65e4be1b05, type: 2}
  arrivalSound: {fileID: 8300000, guid: 552da15d865e55e7924a887530bf944d, type: 3}
  arrivalDelay: 0.7643125
  lines:
  - speaker: {fileID: 11400000, guid: 3fa28df6608b7f44db2e8d65e4be1b05, type: 2}
    text: "\u4F60\u5E08\u7236\u7559\u4E0B\u7684\u5B57\uFF0C\u672A\u5FC5\u5C31\u662F\u522B\u4EBA\u8BA9\u4F60\u8BFB\u5230\u7684\u5B57\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u4F60\u60F3\u8BA9\u6211\u76F8\u4FE1\u4EC0\u4E48\uFF1F"
  - speaker: {fileID: 11400000, guid: 3fa28df6608b7f44db2e8d65e4be1b05, type: 2}
    text: "\u5148\u67E5\u7B2C\u4E03\u53F7\u5C01\u6863\uFF0C\u90A3\u91CC\u7559\u7740\u6362\u7248\u524D\u7684\u8BB0\u5F55\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u662F\u8C01\u4FDD\u5B58\u4E86\u8FD9\u4EFD\u8BB0\u5F55\uFF1F"
  - speaker: {fileID: 11400000, guid: 3fa28df6608b7f44db2e8d65e4be1b05, type: 2}
    text: "\u4E00\u4E2A\u8FD8\u4E0D\u80FD\u8BA9\u540D\u5B57\u79BB\u5F00\u5C01\u888B\u7684\u4EBA\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u6211\u4F1A\u67E5\u6765\u6E90\uFF0C\u4E5F\u4F1A\u8BB0\u4E0B\u4F60\u6CA1\u6709\u56DE\u7B54\u7684\u95EE\u9898\u3002"
