  id: beatrice
  title: "\u7B2C\u4E8C\u5E55 \xB7 \u8D1D\u963F\u7279\u4E3D\u5207\u7684\u4FBF\u6761"
  context: "2026-11-02 \u8FD4\u56DE\u6539\u7A3F\uFF1B\u89C1 doc/performance-edit\u3002"
  testOnly: 0
  initialVisitor: {fileID: 11400000, guid: 3fa28df6608b7f44db2e8d65e4be1b05, type: 2}
  arrivalSound: {fileID: 8300000, guid: a90926b1834a5135a7889bc8801033ca, type: 3}
  closeShutterOnComplete: 1
  arrivalDelay: 0.54485416
  lines:
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u5362\u5361\uFF0C\u5A01\u5C3C\u65AF\u4EE3\u8868\u8D1D\u963F\u7279\u4E3D\u5207\u5973\u58EB\u6C42\u89C1\uFF0C\u968F\u8EAB\u5E26\u6765\u4E86\u4E00\u4EFD\u6587\u4EF6\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: 3fa28df6608b7f44db2e8d65e4be1b05, type: 2}
    text: "\u4F60\u5C31\u662F\u5362\u5361\u5927\u5E08\u5427\uFF1F\u8FD9\u6869\u6848\u5B50\u6211\u5DF2\u6697\u4E2D\u67E5\u8BBF\u6570\u65E5\uFF0C\u8D35\u884C\u4F1A\u7684\u4E00\u4F4D\u540C\u50DA\u79C1\u4E0B\u585E\u7ED9\u6211\u4E00\u5F20\u5B57\u6761\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: 3fa28df6608b7f44db2e8d65e4be1b05, type: 2}
    text: "\u4ED6\u6015\u60F9\u7978\u4E0A\u8EAB\uFF0C\u4E0D\u80AF\u51FA\u9762\u4F5C\u8BC1\uFF0C\u4FBF\u7528\u4E86\u5BC6\u7801\u3002\u60F3\u6765\u4F60\u5E94\u8BE5\u80FD\u89E3\u5F00\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: 3fa28df6608b7f44db2e8d65e4be1b05, type: 2}
    text: "\u5B57\u6761\u4E0A\u7684\u5185\u5BB9\u6211\u5927\u81F4\u731C\u5F97\u5230\uFF0C\u4F46\u788D\u4E8E\u5A01\u5C3C\u65AF\u7684\u7ACB\u573A\uFF0C\u8FD9\u6761\u7EBF\u6211\u4E0D\u4FBF\u518D\u67E5\u4E0B\u53BB\u4E86\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u8BF7\u628A\u4FBF\u6761\u4EA4\u7ED9\u6211\u5427\uFF0C\u6211\u4F1A\u4EB2\u81EA\u6838\u5B9E\u3002"
    endEvent: 0
    choices: []
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u5A01\u5C3C\u65AF\u4EE3\u8868\u4EA4\u6765\u7684\u5B57\u6761\u5DF2\u767B\u8BB0\u5165\u518C\uFF0C\u6211\u8FD9\u5C31\u9012\u8FDB\u6765\u3002"
    endEvent: 0
    choices: []
