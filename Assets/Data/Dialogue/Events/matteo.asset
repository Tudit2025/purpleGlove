  lines:
  - speaker: {fileID: 11400000, guid: 7a00ade9d6e452c4ba72f85697a011c7, type: 2}
    text: "\u5362\u5361\uFF0C\u4F60\u6CA1\u6709\u66FF\u6211\u5220\u6389\u90A3\u4E00\u9875\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u6211\u4E0D\u80FD\u628A\u6551\u4F60\uFF0C\u5199\u6210\u66FF\u4F60\u8BC1\u660E\u65E0\u9519\u3002"
  - speaker: {fileID: 11400000, guid: 7a00ade9d6e452c4ba72f85697a011c7, type: 2}
    text: "\u90A3\u662F\u6211\u7684\u7B7E\u540D\uFF0C\u4E5F\u8BE5\u7531\u6211\u89E3\u91CA\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u4ECE\u8FD9\u4E00\u53E5\u5F00\u59CB\uFF0C\u6211\u4EEC\u628A\u8BDD\u8BF4\u5168\u3002"
