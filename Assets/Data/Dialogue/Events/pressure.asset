  id: pressure
  title: "04 \xB7 \u539F\u4EF6\u4E0E\u7B7E\u540D"
  context: "\u7B2C\u4E09\u81F3\u56DB\u5E55\u8BD5\u6F14\uFF1A\u516C\u7235\u65BD\u538B\uFF0C\u5361\u62C9\u6CD5\u8981\u6C42\u4EE3\u9886\u3002"
  testOnly: 0
  initialVisitor: {fileID: 11400000, guid: 2480b28aa301a684fa6bbef36dac27d0, type: 2}
  arrivalSound: {fileID: 8300000, guid: 84c1e63242be5365ac0c83769bb04509, type: 3}
  arrivalDelay: 1.0729584
  lines:
  - speaker: {fileID: 11400000, guid: 2480b28aa301a684fa6bbef36dac27d0, type: 2}
    text: "\u79BB\u6668\u4F1A\u5DF2\u7ECF\u4E0D\u8FDC\u4E86\uFF0C\u6838\u9A8C\u4EBA\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u65F6\u95F4\u4E0D\u80FD\u66FF\u4E00\u4EFD\u6587\u4EF6\u8BC1\u660E\u6765\u6E90\u3002"
  - speaker: {fileID: 11400000, guid: 2480b28aa301a684fa6bbef36dac27d0, type: 2}
    text: "\u4F60\u5E08\u7236\u5728\u59D4\u6258\u4E0A\u7B7E\u8FC7\u540D\uFF0C\u4F60\u51C6\u5907\u600E\u6837\u89E3\u91CA\uFF1F"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u6211\u4F1A\u628A\u4ED6\u7684\u7B7E\u540D\u548C\u6362\u7248\u8BB0\u5F55\u5206\u522B\u5217\u660E\u3002"
  - speaker: {fileID: 11400000, guid: 94175edd6df4cee43a29a74d19194265, type: 2}
    text: "\u539F\u4EF6\u53EF\u4EE5\u4EA4\u7ED9\u6211\u4EE3\u9886\uFF0C\u624B\u7EED\u4F1A\u7B80\u5355\u5F97\u591A\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u8BF7\u5148\u89E3\u91CA\uFF0C\u4E24\u6B21\u6362\u7248\u4E3A\u4EC0\u4E48\u90FD\u6709\u4F60\u7684\u7B7E\u6536\u3002"
  - speaker: {fileID: 11400000, guid: 94175edd6df4cee43a29a74d19194265, type: 2}
    text: "\u6211\u7B7E\u6536\u7684\u662F\u5C01\u888B\uFF0C\u91CC\u9762\u7684\u6587\u5B57\u7531\u522B\u4EBA\u8D1F\u8D23\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u8FD9\u53E5\u8BDD\u4E5F\u4F1A\u8FDB\u5165\u5171\u540C\u6838\u9A8C\u7684\u8BB0\u5F55\u3002"
