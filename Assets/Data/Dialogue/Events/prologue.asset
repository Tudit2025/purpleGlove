MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 430074f4a7b53dd4796d71325b7b59c6, type: 3}
  m_Name: prologue
  m_EditorClassIdentifier:
  id: prologue
  title: "\u7B2C\u96F6\u5E55 \xB7 \u95E8\u69DB"
  context: "2026-11-02 返回改稿；见 doc/performance-edit。"
  testOnly: 0
  initialVisitor: {fileID: 0}
  arrivalSound: {fileID: 0}
  arrivalDelay: 0.65
  closeShutterOnComplete: 1
  lines:
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "我是解密大师马泰奥·里奇的学生。"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "我们为印刷行会工作，翻译书本，处理来往密信。"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "前几天，师父去替米兰公爵办事，结果一直没有回来，下落不明。"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "街上有人说他背叛了行会，为公爵伪造书信。"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "现在，行会收到一个紧急核验委托，调查一份许多势力牵扯的军令。米兰要凭它接管威尼斯的边境粮站。"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "米兰、法兰西、威尼斯共同委托，要求行会确认密文明文匹配，流程来路可靠。六月十六日，也就是明早六点，核验结果将作为他们表决的凭据。"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "我作为替补“解密大师”，被调来处理这个委托。"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "我一定要弄清楚事情的真相，把师傅救出来。"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "卢卡大师，房间准备好了。"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "根据流程，你进去之后门会贴封条，届时你不能自由出入了。到明天表决结束才会开门。"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "好的，我要进去了。"
