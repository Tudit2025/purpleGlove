  m_Script: {fileID: 11500000, guid: 430074f4a7b53dd4796d71325b7b59c6, type: 3}
  m_Name: prologue
  m_EditorClassIdentifier:
  id: prologue
  title: "\u7B2C\u96F6\u5E55 \xB7 \u95E8\u69DB"
  context: "doc/ph-revised.md\uFF1A\u7B2C\u96F6\u5E55\u3002\u95E8\u5916\u56FA\u5B9A\u673A\u4F4D\uFF1B\u4E3B\u89D2\u72EC\u767D\u4E0E\u753B\u5916\u6267\u4E8B\uFF1B\u6700\u540E\u4E00\u53E5\u63A8\u8FDB\u540E\u8FDB\u5165\u5DE5\u4F5C\u95F4\u3002"
  testOnly: 0
  initialVisitor: {fileID: 0}
  arrivalSound: {fileID: 0}
  arrivalDelay: 0.65
  lines:
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u6211\u53EB\u5362\u5361\uFF0C\u662F\u9A6C\u6CF0\u5965\xB7\u91CC\u5947\u7684\u5B66\u751F\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u6211\u8DDF\u4ED6\u5B66\u4E86\u4E03\u5E74\u5BC6\u7801\uFF0C\u4E5F\u66FF\u884C\u4F1A\u5904\u7406\u8FC7\u5F80\u6765\u7684\u5BC6\u4FE1\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u524D\u51E0\u5929\uFF0C\u5E08\u7236\u53BB\u66FF\u7C73\u5170\u516C\u7235\u529E\u4E8B\uFF0C\u6CA1\u6709\u56DE\u6765\u3002\u516C\u7235\u7684\u4EBA\u8BF4\uFF0C\u4ED6\u5F97\u7559\u4E0B\u914D\u5408\u6838\u9A8C\u3002\u8FDE\u7559\u5728\u54EA\u91CC\uFF0C\u4E5F\u4E0D\u80AF\u544A\u8BC9\u6211\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u8857\u4E0A\u5DF2\u7ECF\u6709\u4EBA\u8BF4\uFF0C\u4ED6\u66FF\u516C\u7235\u6539\u8FC7\u519B\u4EE4\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u73B0\u5728\uFF0C\u884C\u4F1A\u6536\u5230\u4E00\u4EFD\u5BC6\u6587\uFF0C\u58F0\u79F0\u6CD5\u56FD\u5373\u5C06\u8D8A\u5883\u3002\u7C73\u5170\u8981\u51ED\u5B83\u63A5\u7BA1\u5A01\u5C3C\u65AF\u7684\u8FB9\u5883\u7CAE\u7AD9\u3002\u660E\u65E9\u516D\u70B9\uFF0C\u4ED6\u4EEC\u5C31\u4F1A\u5728\u4F1A\u4E0A\u4F5C\u51B3\u5B9A\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u8FD9\u4EFD\u5BC6\u6587\u7528\u7684\u662F\u5E08\u7236\u7F16\u7684\u5BC6\u7801\u3002\u6211\u53C2\u4E0E\u6574\u7406\u8FC7\u90A3\u5957\u8868\uFF0C\u6240\u4EE5\u884C\u4F1A\u8BA9\u6211\u6765\u8FD8\u539F\u6587\u5B57\u3001\u67E5\u6E05\u6765\u8DEF\u3002\u4E09\u65B9\u90FD\u4F1A\u590D\u6838\u6211\u7684\u7ED3\u679C\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u6211\u60F3\u8BC1\u660E\u90A3\u4E9B\u4F20\u8A00\u662F\u9519\u7684\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u53EF\u6211\u8FD8\u6CA1\u6709\u89C1\u8FC7\u90A3\u4EFD\u6587\u4EF6\uFF0C\u4E5F\u6CA1\u542C\u5230\u5E08\u7236\u4EB2\u53E3\u89E3\u91CA\u3002"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u5362\u5361\uFF0C\u623F\u95F4\u5907\u597D\u4E86\u3002"
  - speaker: {fileID: 11400000, guid: 99e1ffdb51533854ea9cf197f5a21f35, type: 2}
    text: "\u8FDB\u53BB\u4EE5\u540E\u5C01\u95E8\uFF0C\u660E\u65E9\u516D\u70B9\u5F00\u5C01\u3002\u671F\u95F4\u6587\u4EF6\u8D70\u4FA7\u53E3\uFF0C\u6BCF\u6B21\u4EA4\u63A5\u90FD\u6709\u767B\u8BB0\u3002\u6CA1\u67E5\u6E05\u7684\uFF0C\u4F60\u53EF\u4EE5\u4E0D\u7B7E\u3002"
  - speaker: {fileID: 11400000, guid: f79a256ca015acd40a1a1621c22a6779, type: 2}
    text: "\u8BA9\u6211\u8FDB\u53BB\u3002"
